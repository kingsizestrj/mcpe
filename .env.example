# ===========================================================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# ===========================================================================

# ---------- Servidor Bedrock ----------
SERVER_NAME=Meu Servidor Local
GAMEMODE=survival          # survival | creative | adventure
DIFFICULTY=normal          # peaceful | easy | normal | hard
LEVEL_NAME=world
MAX_PLAYERS=10

# ---------- Proteção / acesso ----------
# Allowlist: só quem está na lista entra. RECOMENDADO deixar true.
ALLOW_LIST=true
# Lista inicial "Gamertag:XUID" separada por vírgula (opcional, pode usar o painel).
ALLOW_LIST_USERS=
# Exige login real na conta Xbox Live (bloqueia clientes não autenticados).
ONLINE_MODE=true
# Operadores/admins no jogo. Ex: "MeuGamertag:25xxxxxxxxxxxxx"
OPS=
# Expulsa jogadores inativos depois de N minutos (0 = nunca).
PLAYER_IDLE_TIMEOUT=0

# ---------- Painel Web ----------
# Usuário e senha de acesso ao painel. TROQUE A SENHA!
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-forte
# Chave para assinar a sessão. Gere uma aleatória:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-secreta-aleatoria

# Onde o painel escuta.
#   127.0.0.1 = só na máquina local (mais seguro; use com túnel SSH/VPN)
#   0.0.0.0   = acessível na rede local (LAN)
PANEL_BIND=127.0.0.1
PANEL_PORT=8080
