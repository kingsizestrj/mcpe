# ===========================================================================
# Copie este arquivo para .env e ajuste os valores:
#   cp .env.example .env
# ===========================================================================

# ---------- Servidor Bedrock ----------
# As configs do servidor (nome, gamemode, dificuldade, mundo, max-players,
# online-mode, idle-timeout) agora são editadas pelo PAINEL (seção
# "Configurações do servidor") e gravadas no server.properties. Por isso não
# ficam mais aqui — assim um restart não sobrescreve o que você define no painel.

# ---------- Proteção / acesso ----------
# Allowlist e online-mode são controlados pelo PAINEL (persistidos no
# server.properties). Os campos abaixo são apenas "seeds" de inicialização:
# Lista inicial "Gamertag:XUID" separada por vírgula (opcional, pode usar o painel).
ALLOW_LIST_USERS=
# Operadores/admins no jogo. Ex: "MeuGamertag:25xxxxxxxxxxxxx"
OPS=

# ---------- Backups ----------
# Intervalo dos backups automáticos em horas (0 = desativado). Ex: 24 = diário.
BACKUP_INTERVAL_HOURS=0
# Quantos backups manter (os mais antigos são apagados).
BACKUP_KEEP=7

# ---------- Monitor de recursos ----------
# Frequência (segundos) de amostragem de CPU/RAM e limites de alerta (%).
MONITOR_INTERVAL=30
CPU_ALERT=90
MEM_ALERT=90

# ---------- Notificações (Discord / Telegram) ----------
# Avisos de servidor caiu/voltou, jogador entrou/saiu, erros e sobrecarga.
# Configure pelo menos um canal para ativar.
# Discord: crie um Webhook no canal (Editar canal > Integrações > Webhooks).
NOTIFY_DISCORD_WEBHOOK=
# Telegram: crie um bot com @BotFather e descubra seu chat_id (@userinfobot).
NOTIFY_TELEGRAM_TOKEN=
NOTIFY_TELEGRAM_CHAT=
# Avisar quando alguém entra/sai e quando aparece erro no log.
NOTIFY_PLAYERS=true
NOTIFY_ERRORS=true

# ---------- Exposição remota (port forward) ----------
# Porta UDP externa que você vai liberar no roteador apontando para esta máquina.
# Mantenha 19132 (padrão) para conectar fácil pelo celular: dominio:19132
GAME_PORT=19132

# Blindagem de firewall (scripts/harden-firewall.sh):
# Taxa máxima de pacotes por IP de origem antes de descartar (anti-flood).
RATE_ABOVE=80/sec
RATE_BURST=120
# (Opcional) Só estes IPs/CIDRs alcançam a porta do jogo. Em branco = liberado
# para qualquer IP (a allowlist do jogo continua protegendo a entrada).
# Útil se seus amigos tiverem IP fixo. Ex: ALLOW_IPS=203.0.113.5,198.51.100.0/24
ALLOW_IPS=

# ---------- Painel Web ----------
# Usuário e senha de acesso ao painel. TROQUE A SENHA!
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-forte
# Chave para assinar a sessão. Gere uma aleatória:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-secreta-aleatoria

# Onde o painel escuta.
#   127.0.0.1 = só na máquina local (mais seguro; use com túnel SSH/VPN)
#   0.0.0.0   = acessível na rede local (LAN)
PANEL_BIND=127.0.0.1
PANEL_PORT=8080
